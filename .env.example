# Session cookies
# Required in production for signed httpOnly session cookies.
SESSION_SECRET=

# Database
# Neon Postgres connection string used by Drizzle.
DATABASE_URL=

# AI SDK providers
# Required for /api/chat with the current Anthropic model.
ANTHROPIC_API_KEY=

# Required for knowledge-base embeddings and retrieval.
OPENAI_API_KEY=

# Optional providers already installed for future model/tool experiments.
GROQ_API_KEY=
ELEVENLABS_API_KEY=

# Exposed to the client through the root loader env object.
# See app/root.tsx, app/hooks/use-root-loader.ts, and app/hooks/use-env.ts.
MAPTILER_API_KEY=
